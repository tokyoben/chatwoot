#!/bin/bash
# Diagnostic script for Message Interceptor setup
# Run this on your AWS Chatwoot server

echo "=== Chatwoot Message Interceptor Diagnostic ==="
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get Chatwoot directory (assuming script is in bin/)
CHATWOOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$CHATWOOT_DIR"

echo "Chatwoot directory: $CHATWOOT_DIR"
echo ""

# Check 1: Environment Variables
echo "1. Checking environment variables..."
if [ -z "$MESSAGE_INTERCEPTOR_URL" ]; then
  echo -e "${RED}✗ MESSAGE_INTERCEPTOR_URL not set${NC}"
  echo "  Try: RAILS_ENV=production bundle exec rails runner \"puts ENV['MESSAGE_INTERCEPTOR_URL']\""
else
  echo -e "${GREEN}✓ MESSAGE_INTERCEPTOR_URL = $MESSAGE_INTERCEPTOR_URL${NC}"
fi

if [ -z "$MESSAGE_INTERCEPTOR_API_KEY" ]; then
  echo -e "${RED}✗ MESSAGE_INTERCEPTOR_API_KEY not set${NC}"
else
  echo -e "${GREEN}✓ MESSAGE_INTERCEPTOR_API_KEY = ${MESSAGE_INTERCEPTOR_API_KEY:0:20}...${NC}"
fi

if [ -z "$FRONTEND_URL" ]; then
  echo -e "${YELLOW}⚠ FRONTEND_URL not set (optional but recommended)${NC}"
else
  echo -e "${GREEN}✓ FRONTEND_URL = $FRONTEND_URL${NC}"
fi
echo ""

# Check 2: Rails can access env vars
echo "2. Checking if Rails can access environment variables..."
URL=$(RAILS_ENV=production bundle exec rails runner "puts ENV['MESSAGE_INTERCEPTOR_URL']" 2>/dev/null)
if [ -z "$URL" ] || [ "$URL" = "http://localhost:3001/translate" ]; then
  echo -e "${RED}✗ Rails environment not configured properly${NC}"
  echo "  Current URL: $URL (this is the default, not configured)"
else
  echo -e "${GREEN}✓ Rails sees URL: $URL${NC}"
fi
echo ""

# Check 3: Sidekiq running
echo "3. Checking if Sidekiq is running..."
if pgrep -f "sidekiq.*chatwoot" > /dev/null; then
  echo -e "${GREEN}✓ Sidekiq is running${NC}"
  pgrep -f "sidekiq.*chatwoot" | while read pid; do
    echo "  PID: $pid"
  done
else
  echo -e "${RED}✗ Sidekiq not running${NC}"
  echo "  MessageInterceptorJob won't execute without Sidekiq!"
fi
echo ""

# Check 4: RAG server accessibility
echo "4. Checking RAG server connectivity..."
if [ -n "$URL" ] && [ "$URL" != "http://localhost:3001/translate" ]; then
  # Extract host and port from URL
  RAG_URL="$URL"

  echo "  Testing connection to: $RAG_URL"

  if command -v curl &> /dev/null; then
    RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" -X POST "$RAG_URL" \
      -H "Content-Type: application/json" \
      -d '{"message_id":999,"content":"test"}' \
      --connect-timeout 5 2>&1)

    if [ "$RESPONSE" = "200" ]; then
      echo -e "${GREEN}✓ RAG server is accessible and responding${NC}"
    else
      echo -e "${RED}✗ RAG server returned HTTP $RESPONSE or is unreachable${NC}"
    fi
  else
    echo -e "${YELLOW}⚠ curl not available, skipping connectivity test${NC}"
  fi
else
  echo -e "${YELLOW}⚠ Skipping (URL not configured)${NC}"
fi
echo ""

# Check 5: Recent logs
echo "5. Checking recent logs for MessageInterceptor activity..."
if [ -f "log/production.log" ]; then
  RECENT=$(grep "MessageInterceptor" log/production.log | tail -5)
  if [ -n "$RECENT" ]; then
    echo -e "${GREEN}✓ Found MessageInterceptor log entries:${NC}"
    echo "$RECENT" | sed 's/^/  /'
  else
    echo -e "${YELLOW}⚠ No MessageInterceptor entries in production.log${NC}"
    echo "  This means no messages have been processed yet"
  fi
else
  echo -e "${RED}✗ log/production.log not found${NC}"
fi
echo ""

# Check 6: Sidekiq queue
echo "6. Checking Sidekiq queue for pending jobs..."
QUEUE_SIZE=$(RAILS_ENV=production bundle exec rails runner "puts Sidekiq::Queue.new('default').size" 2>/dev/null)
if [ -n "$QUEUE_SIZE" ]; then
  if [ "$QUEUE_SIZE" -gt 0 ]; then
    echo -e "${YELLOW}⚠ $QUEUE_SIZE jobs in queue (some might be interceptor jobs)${NC}"
  else
    echo -e "${GREEN}✓ Queue is empty${NC}"
  fi
else
  echo -e "${RED}✗ Could not check queue (Sidekiq may not be running)${NC}"
fi
echo ""

# Summary
echo "=== Summary ==="
if [ -z "$MESSAGE_INTERCEPTOR_URL" ] || [ "$URL" = "http://localhost:3001/translate" ]; then
  echo -e "${RED}ACTION REQUIRED: Set MESSAGE_INTERCEPTOR_URL environment variable${NC}"
  echo ""
  echo "Add to your .env file or systemd service:"
  echo "  MESSAGE_INTERCEPTOR_URL=http://localhost:3003/interceptor/translate"
  echo "  MESSAGE_INTERCEPTOR_API_KEY=dc45ef45b90e18bc4f80e77bf2cef19bc966350e96bdc69662586a6137045276"
  echo ""
  echo "Then restart Chatwoot:"
  echo "  sudo systemctl restart chatwoot-web chatwoot-worker"
elif ! pgrep -f "sidekiq.*chatwoot" > /dev/null; then
  echo -e "${RED}ACTION REQUIRED: Start Sidekiq${NC}"
  echo "  sudo systemctl start chatwoot-worker"
else
  echo -e "${GREEN}Configuration looks good!${NC}"
  echo ""
  echo "Next steps:"
  echo "1. Send a test message from the widget"
  echo "2. Check logs: tail -f log/production.log | grep MessageInterceptor"
  echo "3. Check RAG server logs for incoming requests"
fi
echo ""
echo "For detailed setup instructions, see: INTERCEPTOR_AWS_SETUP.md"
