# Chatwoot MITM Interceptor Configuration
# Copy these to your .env file and update values

# Your translation backend URL (required)
# This is where Chatwoot will POST messages for translation
# Note: The path should be /interceptor/translate (not just /translate)
MESSAGE_INTERCEPTOR_URL=http://localhost:3003/interceptor/translate

# API key for authentication (required)
# Use the same key in both Chatwoot and your translation backend
MESSAGE_INTERCEPTOR_API_KEY=your-secret-key-change-this-in-production

# HTTP request timeout in seconds (optional, default: 5)
MESSAGE_INTERCEPTOR_TIMEOUT=5

# Your Chatwoot frontend URL (required for callback URL generation)
FRONTEND_URL=https://your-chatwoot-instance.com
